#!/bin/sh
# GKD Mini Plus thermal guard (user space). The kernel's step_wise policy is bound only to the
# first passive trip (83 C) and backs off as soon as the temperature trend flattens, so a
# sustained 4-core load climbs past 90 C into the 95 C hardware shutdown (tsadc tshut, GPIO
# mode -> instant reset, no logs). This caps scaling_max_freq instead:
#   >= HOT (90 C): straight down to FLOOR_HOT; >= WARM (86 C): one step down every 2 s;
#   <= COOL (80 C): one step up every 5 s. The cap is removed again on exit.
# Usage: gkd-thermal [run]   (foreground loop; start it as a service)
POLICY=/sys/devices/system/cpu/cpufreq/policy0
ZONES="/sys/class/thermal/thermal_zone0/temp /sys/class/thermal/thermal_zone1/temp"
HOT=90000 WARM=86000 COOL=80000
FLOOR_HOT=1104000 FLOOR=816000
FREQS=$(tr ' ' '\n' < $POLICY/scaling_available_frequencies | grep . | sort -n)
MAX=$(cat $POLICY/cpuinfo_max_freq)

temp() { t=0; for z in $ZONES; do v=$(cat "$z" 2>/dev/null || echo 0); [ "$v" -gt "$t" ] && t=$v; done; echo $t; }
step_down() { for f in $(echo "$FREQS" | sort -rn); do [ "$f" -lt "$1" ] && { echo "$f"; return; }; done; echo "$1"; }
step_up() { for f in $FREQS; do [ "$f" -gt "$1" ] && { echo "$f"; return; }; done; echo "$1"; }
set_cap() { [ "$1" != "$cap" ] && { cap=$1; echo "$cap" > $POLICY/scaling_max_freq; echo "$(date +%T) $(( $(temp) / 1000 ))C cap $(( cap / 1000 ))MHz"; }; }

cap=$(cat $POLICY/scaling_max_freq)
trap 'echo "$MAX" > $POLICY/scaling_max_freq; exit 0' INT TERM
n=0
while :; do
  t=$(temp); n=$((n + 1))
  if [ "$t" -ge $HOT ]; then
    [ "$cap" -gt $FLOOR_HOT ] && set_cap $FLOOR_HOT
  elif [ "$t" -ge $WARM ]; then
    [ $((n % 2)) = 0 ] && [ "$cap" -gt $FLOOR ] && set_cap "$(step_down "$cap")"
  elif [ "$t" -le $COOL ]; then
    [ $((n % 5)) = 0 ] && [ "$cap" -lt "$MAX" ] && set_cap "$(step_up "$cap")"
  fi
  sleep 1
done
